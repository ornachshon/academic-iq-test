{
  "name": "FunnelEvent",
  "type": "object",
  "allow_public_create": true,
  "properties": {
    "event_name": {
      "type": "string",
      "description": "Name of the funnel event"
    },
    "session_id": {
      "type": "string",
      "description": "Anonymous session identifier"
    }
  },
  "required": [
    "event_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}